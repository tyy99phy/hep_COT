# hep_cot — environment variables
#
# Copy this file to `.env` and fill in the keys for the providers you want
# to use. The CLI picks them up via os.environ; tools like `direnv` or
# `python-dotenv` can auto-load them. `.env` itself is git-ignored.

# --- Required: at least one provider --------------------------------------

# OpenAI (used by the teacher role and the default `paper` / `ask` copilot).
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# DeepSeek (used by the student role in the comparative study).
# Get a key at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-...

# --- Optional: provider base-URL overrides --------------------------------
# Useful when routing through a proxy / gateway (e.g. OpenRouter, CRS,
# Azure-compatible OpenAI endpoints).

# OPENAI_BASE_URL=https://api.openai.com/v1
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Optional: external-API niceties --------------------------------------
# INSPIRE-HEP and HEPData are public and keyless, but if you hit rate limits
# you can identify yourself via a contact email in the User-Agent.

# HEP_COT_CONTACT_EMAIL=you@example.com
