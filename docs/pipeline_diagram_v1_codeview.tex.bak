% hep_COT framework — end-to-end pipeline diagram
% Compile: xelatex pipeline_diagram.tex
\documentclass[11pt]{article}
\usepackage[a3paper, landscape, margin=1cm]{geometry}
\usepackage[UTF8]{ctex}
\usepackage{xcolor}
\usepackage{tikz}
\usepackage{amsmath}
\usepackage{array}
\usepackage{adjustbox}
\usetikzlibrary{
  positioning, arrows.meta, shapes.geometric, shapes.misc,
  calc, fit, backgrounds, decorations.pathreplacing, decorations.markings
}

\definecolor{cInput}{RGB}{70, 90, 120}
\definecolor{cTeacher}{RGB}{60, 130, 180}
\definecolor{cNative}{RGB}{60, 160, 110}
\definecolor{cAligned}{RGB}{220, 130, 50}
\definecolor{cJudge}{RGB}{140, 90, 170}
\definecolor{cMetrics}{RGB}{200, 160, 60}
\definecolor{cPatch}{RGB}{200, 60, 80}

\tikzset{
  base/.style={
    rectangle, rounded corners=2pt, draw=black!40, line width=0.5pt,
    align=center, font=\small, inner sep=5pt, minimum height=8mm
  },
  io/.style={base, fill=cInput!15, draw=cInput!70, text=cInput!80!black},
  teacher/.style={base, fill=cTeacher!12, draw=cTeacher!70, text=cTeacher!80!black},
  native/.style={base, fill=cNative!15, draw=cNative!70, text=cNative!80!black},
  aligned/.style={base, fill=cAligned!18, draw=cAligned!80, text=cAligned!80!black},
  judge/.style={base, fill=cJudge!15, draw=cJudge!70, text=cJudge!80!black},
  metrics/.style={base, fill=cMetrics!22, draw=cMetrics!80, text=black},
  patch/.style={base, fill=cPatch!12, draw=cPatch!70, text=cPatch!80!black, font=\footnotesize\sffamily},
  note/.style={font=\scriptsize\itshape, text=black!55, align=left},
  arrow/.style={-{Stealth[length=2.5mm, width=2mm]}, line width=0.55pt, draw=black!65},
  darrow/.style={arrow, dashed, draw=black!55},
  loop/.style={arrow, draw=cAligned!80, line width=0.7pt},
  title/.style={font=\large\bfseries},
  subtitle/.style={font=\small\bfseries, text=black!70},
  cluster/.style={rectangle, rounded corners=5pt, draw=black!25, line width=0.4pt, dashed, inner sep=8pt},
}

\begin{document}
\pagestyle{empty}

% ===================================================================
% PAGE 1 — TOP-LEVEL PIPELINE
% ===================================================================
\begin{center}
{\Large\bfseries hep\_COT 框架总流程图} \\
{\small 论文 $\to$ 三路执行（teacher / student\_native / student\_aligned）$\to$ 对齐式评估 $\to$ metrics 报表}
\end{center}

\vspace{-0.4em}
\begin{adjustbox}{max totalsize={\textwidth}{0.88\textheight}, center}
\begin{tikzpicture}[node distance=6mm and 10mm]

% --- Input layer ---
\node[io, text width=45mm] (paper) {\textbf{arXiv paper}\\
  \scriptsize identifier, e.g.\ \texttt{2206.08956}};

\node[io, right=14mm of paper, text width=62mm] (registry)
  {\textbf{build\_hep\_registry}\\
   \scriptsize 注册 HEP 工具：get\_paper\_info, list\_figures,\\
   fetch\_hepdata, get\_hepdata\_table, search\_paper, \ldots\\
   \scriptsize 解析 paper\_info（title, abstract, \#figures）};

\draw[arrow] (paper) -- (registry);

% --- Shared phase spec ---
\node[io, right=14mm of registry, text width=58mm] (phases)
  {\textbf{PROTOCOL\_PHASES} (固定 6 阶段)\\
   \scriptsize \texttt{overview} $\to$ \texttt{motivation} $\to$ \texttt{strategy}\\
   \scriptsize $\to$ \texttt{syst} $\to$ \texttt{stat\_result}$^{\star}$ $\to$ \texttt{assessment}\\
   \scriptsize 每 phase 声明 required\_outputs \&\ submit 工具 schema\\
   \scriptsize \textit{$^{\star}$ stat\_result 后触发 figure\_coverage forced pass}};
\draw[arrow] (registry) -- (phases);

% Fit the full input row so the run nodes sit below the LOWEST of them.
\node[fit=(paper)(registry)(phases), inner sep=0pt] (inputrow) {};

% --- Three parallel runs, TOP-aligned below the input row ---
\node[teacher, text width=52mm, anchor=north west]
  at ([yshift=-12mm]inputrow.south west) (teacher)
  {\textbf{Teacher Run}\\
   \scriptsize provider = openai (o-series, high reasoning)\\
   \scriptsize Phase6ProtocolRunner.run\_all():\\
   \scriptsize \quad for phase in PHASES:\\
   \scriptsize \qquad result = run\_phase(phase)\\
   \scriptsize \qquad save phase\_NN\_<key>.json\\
   \scriptsize \qquad prior\_summaries $\leftarrow$ summary(result)};

\node[native, text width=52mm, anchor=north west]
  at ([xshift=10mm]teacher.north east) (native)
  {\textbf{Student Native Run}\\
   \scriptsize provider = deepseek, \textbf{无 feedback}\\
   \scriptsize 与 teacher 同一 run\_all() 流程，\\
   \scriptsize 但不看 teacher 结果 —— 基线能力\\
   \scriptsize prior\_summaries 全部来自自己\\
   \scriptsize 产出 phase\_NN\_<key>.json × 6};

\node[aligned, text width=62mm, anchor=north west]
  at ([xshift=10mm]native.north east) (aligned)
  {\textbf{Student Aligned Run (autoloop)}\\
   \scriptsize provider = deepseek, \textbf{带 teacher 对齐反馈}\\
   \scriptsize run\_protocol\_autoloop()：每 phase 最多 3 轮重试\\
   \scriptsize Round 0 $\equiv$ native；失败 $\to$ judge $\to$ feedback $\to$ retry\\
   \scriptsize \textbf{best-of-rounds} 选优 + FINAL 落盘同步\\
   \scriptsize (详见第 2 页)};

\draw[arrow] (paper.south)    |- ([yshift=3mm]teacher.north west) -- (teacher.north west);
\draw[arrow] (registry.south) |- ([yshift=3mm]native.north west)  -- (native.north west);
\draw[arrow] (phases.south)   |- ([yshift=3mm]aligned.north west) -- (aligned.north west);

% --- Output artifacts from each run ---
\node[io, below=12mm of teacher, text width=52mm] (tout)
  {\texttt{teacher\_<paper>\_<ts>/}\\
   \scriptsize 6× phase\_NN\_<key>.json\\
   \scriptsize session\_manifest.json, ANALYSIS.md};

\node[io, below=12mm of native, text width=52mm] (nout)
  {\texttt{student\_native\_<paper>\_<ts>/}\\
   \scriptsize 6× phase\_NN\_<key>.json};

\node[io, below=12mm of aligned, text width=62mm] (aout)
  {\texttt{student\_aligned\_<paper>\_<ts>/}\\
   \scriptsize 6× phase\_NN\_<key>.json (FINAL = best-of-rounds)\\
   \scriptsize + phase\_NN\_<key>\_round\{1,2,3\}.json (审计)\\
   \scriptsize + phase\_NN\_figure\_coverage.json (stat\_result 后)};

\draw[arrow] (teacher) -- (tout);
\draw[arrow] (native) -- (nout);
\draw[arrow] (aligned) -- (aout);

% --- Judge in aligned depends on teacher ---
\draw[darrow, draw=cJudge!70] ([yshift=-3mm]tout.east) .. controls +(18mm,-4mm) and +(-32mm,-5mm) ..
  node[pos=0.55, above, font=\scriptsize\itshape, text=cJudge!80!black] {judge\_phase 对比}
  ([yshift=-3mm]aout.west);

% --- Metrics aggregation ---
\node[metrics, below=14mm of nout, text width=96mm] (agg)
  {\textbf{aggregate\_protocol\_metrics(teacher, native, aligned)}\\
   \scriptsize 对 native \& aligned 两路分别 judge：\\
   \scriptsize \quad L1 (numbers $\ge$0.80 \& citations $\ge$0.70) \ \ L2 (tool Levenshtein)\\
   \scriptsize \quad L4 (required\_outputs $\ge$80\% non-empty)\\
   \scriptsize \ figure\_coverage\_rate, hepdata\_utilization\_rate, phase\_continuity};

\draw[arrow] (tout.south) |- ([xshift=-20mm, yshift=3mm]agg.north) -- ([xshift=-20mm]agg.north);
\draw[arrow] (nout.south) -- ([yshift=3mm]agg.north) -- (agg.north);
\draw[arrow] (aout.south) |- ([xshift=20mm, yshift=3mm]agg.north) -- ([xshift=20mm]agg.north);

% --- Final outputs ---
\node[metrics, below=8mm of agg, text width=60mm] (mjson)
  {\texttt{metrics\_<paper>\_<ts>.json}\\
   \scriptsize per-phase L1/L4 pass, totals, figure coverage};

\node[metrics, right=10mm of mjson, text width=60mm] (md)
  {\texttt{ANALYSIS.md} (每 run 目录)\\
   \scriptsize human-readable 的 phase findings 汇总};

\draw[arrow] (agg) -- (mjson);
\draw[arrow] (agg) -- (md);

% --- Legend ---
\node[cluster, below right=3mm and 3mm of md, text width=105mm, align=left] (legend) {
  \small\textbf{三路语义对比}\\
  \scriptsize\textcolor{cTeacher!80!black}{\textbf{teacher}}\quad 高能力模型做上限（reference，本身不做 judge）\\
  \scriptsize\textcolor{cNative!80!black}{\textbf{student\_native}}\quad 目标模型裸能力（无 feedback baseline）\\
  \scriptsize\textcolor{cAligned!80!black}{\textbf{student\_aligned}}\quad 目标模型 $+$ teacher 反馈对齐（autoloop 详见第 2 页）
};

\end{tikzpicture}
\end{adjustbox}

\newpage

% ===================================================================
% PAGE 2 — AUTOLOOP DETAIL
% ===================================================================
\begin{center}
{\Large\bfseries student\_aligned autoloop 细节}\\
{\small 单个 phase 内：round 0 (native-style) $\to$ judge $\to$ feedback retry (最多 3) $\to$ best-of-rounds $\to$ FINAL 同步}
\end{center}

\vspace{-0.3em}
\vspace{-0.3em}
\begin{adjustbox}{max totalsize={\textwidth}{0.88\textheight}, center}
\begin{tikzpicture}[node distance=6mm and 9mm]

% --- Phase loop outer ---
\node[subtitle] (ph_title) {\textbf{for i, phase in enumerate(PROTOCOL\_PHASES, start=1):}};

% --- Round 0 (native-style) ---
\node[aligned, below=5mm of ph_title, text width=70mm] (r0)
  {\textbf{Round 0 — native-style 裸跑}\\
   \scriptsize \texttt{native\_dict = runner.run\_phase(phase)}\\
   \scriptsize \quad extra\_user\_prefix = ""（无 feedback）\\
   \scriptsize \quad prior\_summaries 注入 user prompt\\
   \scriptsize \texttt{\_save\_phase(i, key, native\_dict)}\\
   \scriptsize \quad $\to$ \texttt{phase\_NN\_<key>.json} (tentative FINAL)};

% --- run_phase internals ---
\node[base, right=12mm of r0, fill=black!4, text width=78mm] (runphase)
  {\textbf{run\_phase(phase, extra\_user\_prefix)} 内部\\
   \scriptsize
   1. \texttt{sys} = base system + paper\_info\\
   2. \texttt{user} = prior\_summaries block $\|$ phase.prompt\_template\\
   \hspace*{3mm} $\|$ hepdata\_hint $\|$ submit-tool 规约\\
   3. 若 extra\_user\_prefix：prepend 到 user\\
   4. \textbf{fresh AgentState}（跨 phase 不留 raw messages）\\
   5. tool registry = HEP tools + \texttt{submit\_<phase>\_answer}\\
   6. AgentLoop 跑 max\_tool\_iterations=10：model 调工具\\
   \hspace*{3mm} → 读 paper/HEPData → 最后调 submit\_* 一次\\
   7. submit 的 arguments \textbf{就是}结构化 answer\_parsed};

\node[patch, below=3mm of runphase, text width=78mm] (patch_submit)
  {\textbf{Patch \#2: \_submit 空 findings 防御}\\
   若 required\_outputs 全空 → 返回 \{rejected, missing\_keys\}\\
   允许最多 2 次拒绝，第 3 次兜底接受（防死循环）};

\draw[arrow] (r0) -- (runphase);

% --- Judge ---
\node[judge, below=18mm of r0, text width=70mm] (judge0)
  {\textbf{judge\_phase(phase, teacher[key], native\_dict)}\\
   \scriptsize \textbf{L1 numbers}: \_collect\_numbers 集合 matched/total, tol=5\%, pass $\ge$ 0.80\\
   \scriptsize \textbf{L1 citations}: §/Fig/Table/HEPData/arXiv 标签, pass $\ge$ 0.70\\
   \scriptsize \textbf{L2 tool seq}: Levenshtein(teacher, student), 仅诊断\\
   \scriptsize \textbf{L4 required\_outputs}: 非空且 $\ne$ "[uncertain]" 占 $\ge$ 80\% $\to$ pass\\
   \scriptsize \textbf{overall\_pass} $=$ L1 $\wedge$ L4；diff\_summary 给锚点但不泄露原文};

\draw[arrow] (r0) -- (judge0);

\node[judge, right=12mm of judge0, text width=78mm, align=left] (best_init)
  {\textbf{best tracker 初始化}\\
   \scriptsize \texttt{best\_verdict = verdict\_0}\\
   \scriptsize \texttt{best\_accepted = native\_dict}\\
   \scriptsize \texttt{best\_round = 0}\\
   \scriptsize \textbf{\_verdict\_score(v)} 排序键（tuple, 逐位比较）:\\
   \scriptsize \quad (overall\_pass, L1\_pass+L4\_pass,\\
   \scriptsize \quad \phantom{(} L4\_keys\_present,\\
   \scriptsize \quad \phantom{(} L1\_num\_hit + L1\_cit\_hit)};

\draw[arrow] (judge0) -- (best_init);

% --- Retry loop ---
\node[aligned, below=10mm of judge0, text width=70mm] (retry)
  {\textbf{retry loop} (rounds $<$ 3 且 $\neg$ best.overall\_pass)\\
   \scriptsize rounds $\mathrel{+}=$ 1\\
   \scriptsize \texttt{feedback = build\_phase\_feedback(best.verdict, rounds)}\\
   \scriptsize \texttt{redo = run\_phase(phase, extra\_user\_prefix=feedback)}\\
   \scriptsize \texttt{\_save\_phase(i, key, redo, round\_number=rounds)}\\
   \scriptsize \quad $\to$ \texttt{phase\_NN\_<key>\_roundR.json}\\
   \scriptsize \texttt{v = judge\_phase(...)}\\
   \scriptsize \textbf{if \_verdict\_score(v) $>$ \_verdict\_score(best):}\\
   \scriptsize \quad best $\leftarrow$ (redo, v, rounds)};

\node[judge, right=12mm of retry, text width=78mm] (feedback)
  {\textbf{build\_phase\_feedback}（对齐信号的唯一载体）\\
   \scriptsize "请重做 Phase <key>。第 R 轮。\\
   \scriptsize 裁判给出的差异摘要：\\
   \scriptsize \quad - 缺失 required keys: \{missing\}\\
   \scriptsize \quad - 参考中的关键数值缺失（含单位）\\
   \scriptsize \quad - 缺少锚点: \{missing\_citations\}\\
   \scriptsize 重新思考，必要时调用额外工具亲自验证。\\
   \scriptsize \textbf{不要盲目采纳假设的参考数值}。"\\
   \scriptsize $\hookrightarrow$ \textbf{只给锚点名，不泄露 teacher 的 findings 原文}};

\draw[loop] (retry.south) .. controls +(0,-8mm) and +(-24mm,-8mm) ..
  node[pos=0.5, below, font=\scriptsize\itshape] {循环至 pass 或 rounds=3}
  ([xshift=-24mm]retry.south);

\draw[arrow] (best_init) -- (retry);
\draw[arrow] (retry) -- (feedback);

% --- Finalize phase ---
\node[aligned, below=12mm of retry, text width=70mm] (finalize)
  {\textbf{phase 结束时的 best-of-rounds 提交}\\
   \scriptsize accepted $\leftarrow$ best\_accepted\\
   \scriptsize verdict $\leftarrow$ best\_verdict\\
   \scriptsize \texttt{\_save\_phase(i, key, accepted)} \textbf{(覆盖 round-0)}\\
   \scriptsize $\to$ \texttt{phase\_NN\_<key>.json} 现在 = best};

\node[patch, right=12mm of finalize, text width=78mm] (patch_sync)
  {\textbf{Patch \#1: FINAL sync + best-of-rounds}\\
   旧 bug：盲目接受最后一轮 $\to$ flaky round 3 空 submit\\
   \quad 会把 round 1/2 的好答案盖掉；且 FINAL 磁盘留 round 0，\\
   \quad 与 in-memory accepted 脱节 $\Rightarrow$ metrics 与 ANALYSIS.md 打架\\
   修复：严格按 score 比较，结尾 \_save\_phase 同步落盘};

\draw[arrow] (retry) -- (finalize);
\draw[arrow] (finalize) -- (patch_sync);

% --- Prior summaries flow ---
\node[aligned, below=5mm of finalize, text width=70mm] (prior)
  {\textbf{prior\_summaries 同步（流向下一 phase）}\\
   \scriptsize 回滚 prior\_summaries 到长度 $i-1$\\
   \scriptsize append \texttt{extract\_phase\_summary(accepted)}\\
   \scriptsize (run\_phase 可能在 round-0 附加过 native 版；此处\\
   \scriptsize 替换为 best 的 summary — 保证流向下一 phase 的一定是 best)};

\draw[arrow] (finalize) -- (prior);

% --- Figure coverage forced pass ---
\node[aligned, below=5mm of prior, text width=70mm] (figcov)
  {\textbf{if phase.figure\_coverage\_after}  (仅 \texttt{stat\_result})\\
   \scriptsize \texttt{\_run\_figure\_coverage\_forced\_pass(phase\_index=i)}\\
   \scriptsize 计算 discussed 图集合，缺漏则合成 forced\_phase\\
   \scriptsize 跑一次 run\_phase，产物追加到 phase\_results\\
   \scriptsize $\to$ \texttt{phase\_NN\_figure\_coverage.json}};

\draw[arrow] (prior) -- (figcov);

% --- End of phase loop ---
\node[io, below=8mm of figcov, text width=70mm] (endloop)
  {\textbf{continue to next phase} (或所有 phase 结束)\\
   \scriptsize 全部 phase 完成后：\texttt{\_save\_manifest()} + \texttt{\_write\_analysis\_markdown()}};

\draw[arrow] (figcov) -- (endloop);

% --- Legend / invariants ---
\node[cluster, right=10mm of endloop, text width=95mm, align=left, yshift=20mm] (inv) {
  \small\textbf{关键不变量 (invariants)}\\
  \scriptsize
  \textbf{(i)} Round 0 $\equiv$ student\_native run 的单 phase 调用\\
  \hspace*{3mm}(同 system, 同 user prompt, 同工具集, 无 feedback)\\
  \textbf{(ii)} 跨 phase 只传 compact summary（$\le$ 900 chars），\\
  \hspace*{3mm}不传 raw messages，防止 DeepSeek 128K 爆掉\\
  \textbf{(iii)} FINAL 文件（无 \_round 后缀）永远 = metrics 所用 accepted\\
  \hspace*{3mm} (by patch \#1)\\
  \textbf{(iv)} 反馈里不含 teacher 答案原文，只含 diff 锚点；\\
  \hspace*{3mm}防止学生盲目抄写而非验证\\
  \textbf{(v)} 单轮内 submit 空 findings 会被 2 次拒绝兜底，\\
  \hspace*{3mm}不污染 accepted\_results (by patch \#2)};

\end{tikzpicture}
\end{adjustbox}

\end{document}
