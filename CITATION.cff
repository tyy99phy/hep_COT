    email: tyy99phy@gmail.com
repository-code: "https://github.com/tyy99phy/hep_COT"
license: MIT
version: "0.2.0"
keywords:
  - high-energy-physics
  - large-language-models
  - chain-of-thought
  - scientific-reasoning
  - arxiv
  - hepdata
  - inspire-hep
  - agent
  - tool-use
